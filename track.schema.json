{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://track-layout.local/track.schema.json",
  "title": "Track Layout track",
  "description": "A GTA San Andreas race track: an ordered list of checkpoints. x = east, y = north, z = up.",
  "oneOf": [
    {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/checkpoint" }
    },
    {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "format": { "type": "string", "const": "track-layout/v1" },
        "name": { "type": "string" },
        "author": { "type": "string" },
        "description": { "type": "string" },
        "map": { "type": "string" },
        "closed": { "type": "boolean" },
        "checkpoints": { "$ref": "#/definitions/checkpointList" },
        "cps": { "$ref": "#/definitions/checkpointList" },
        "points": { "$ref": "#/definitions/checkpointList" },
        "cp": { "$ref": "#/definitions/checkpointList" },
        "waypoints": { "$ref": "#/definitions/checkpointList" }
      },
      "anyOf": [
        { "required": ["checkpoints"] },
        { "required": ["cps"] },
        { "required": ["points"] },
        { "required": ["cp"] },
        { "required": ["waypoints"] }
      ],
      "additionalProperties": true
    }
  ],
  "definitions": {
    "checkpointList": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/checkpoint" }
    },
    "checkpoint": {
      "oneOf": [
        {
          "type": "array",
          "minItems": 2,
          "maxItems": 3,
          "items": { "type": "number" },
          "description": "[x, y] or [x, y, z]"
        },
        {
          "type": "string",
          "description": "\"x, y, z\""
        },
        {
          "type": "object",
          "description": "A checkpoint object. x/y are required unless one of the coordinate aliases is used.",
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" },
            "z": { "type": "number" },
            "pos": { "$ref": "#/definitions/pointArray" },
            "position": { "$ref": "#/definitions/pointObject" },
            "coords": { "$ref": "#/definitions/pointArray" },
            "coord": { "$ref": "#/definitions/pointArray" },
            "point": { "$ref": "#/definitions/pointArray" },
            "p": { "$ref": "#/definitions/pointArray" },
            "location": { "$ref": "#/definitions/pointObject" },
            "loc": { "$ref": "#/definitions/pointObject" },
            "type": { "type": "string" },
            "label": { "type": "string" },
            "name": { "type": "string" },
            "title": { "type": "string" },
            "cpName": { "type": "string" },
            "cp_name": { "type": "string" },
            "radius": { "type": "number", "minimum": 0 }
          },
          "anyOf": [
            { "required": ["x", "y"] },
            { "required": ["pos"] },
            { "required": ["position"] },
            { "required": ["coords"] },
            { "required": ["coord"] },
            { "required": ["point"] },
            { "required": ["p"] },
            { "required": ["location"] },
            { "required": ["loc"] }
          ],
          "additionalProperties": true
        }
      ]
    },
    "pointArray": {
      "type": "array",
      "minItems": 2,
      "maxItems": 3,
      "items": { "type": "number" }
    },
    "pointObject": {
      "type": "object",
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "z": { "type": "number" }
      },
      "required": ["x", "y"],
      "additionalProperties": true
    }
  }
}
